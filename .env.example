# Leave everything unset to run OFFLINE (deterministic FakeLLM + hashing embedder).
# Set a provider to run LIVE.
# LLM_PROVIDER=anthropic        # anthropic | openai | gemini | fake
# LLM_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=...
# OPENAI_API_KEY=...
# GEMINI_API_KEY=...
RAG_TOP_K=4
RAG_EMBED_DIM=256
GUARD_MIN_GROUNDING=0.30
